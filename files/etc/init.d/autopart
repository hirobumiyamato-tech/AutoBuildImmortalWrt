#!/bin/sh /etc/rc.common
# 首启：在 sysupgrade/squashfs 场景下：
# - 新建 p3=20G ext4 → 作为 extroot（/overlay）
# - 新建 p4=余量 ext4 → /mnt/docker，并将 Docker data-root 指向该目录
START=99
USE_PROCD=1
FLAG="/etc/.autopart_done"

find_boot_disk() {
  local src; src="$(findmnt -n -o SOURCE /rom 2>/dev/null)"
  [ -z "$src" ] && src="$(findmnt -n -o SOURCE / 2>/dev/null)"
  echo "$src"
}

base_disk_of() {
  local part="$1"
  case "$part" in
    *mmcblk*p[0-9]*) echo "${part%p[0-9]*}";;
    *nvme*n*p[0-9]*) echo "${part%p[0-9]*}";;
    *[0-9])          echo "${part%[0-9]}";;
    *)               echo "$part";;
  esac
}

start() {
  [ -f "$FLAG" ] && exit 0

  # 仅在 squashfs/sysupgrade 场景运行
  mount | grep -q " on /rom " || exit 0

  BOOT_PART="$(find_boot_disk)"
  [ -z "$BOOT_PART" ] && exit 0
  DISK="$(base_disk_of "$BOOT_PART")"
  [ -b "$DISK" ] || exit 0

  case "$DISK" in
    /dev/mmcblk*|/dev/sd*) ;;
    *) exit 0 ;;
  esac

  EXTROOT_MB=20480

  P2="${DISK}p2"; [ -b "$P2" ] || P2="${DISK}2"
  END_SECTOR="$(cat /sys/class/block/$(basename "$P2")/size 2>/dev/null)"
  START_SECTOR_P2="$(cat /sys/class/block/$(basename "$P2")/start 2>/dev/null)"
  DISK_SECTOR_SIZE="$(cat /sys/class/block/$(basename "$DISK")/queue/hw_sector_size 2>/dev/null)"
  [ -z "$DISK_SECTOR_SIZE" ] && DISK_SECTOR_SIZE=512
  [ -z "$START_SECTOR_P2" ] && exit 0

  LAST_END=$(( START_SECTOR_P2 + END_SECTOR - 1 ))
  EXTROOT_SECTORS=$(( (EXTROOT_MB * 1024 * 1024 + DISK_SECTOR_SIZE - 1) / DISK_SECTOR_SIZE ))
  P3_START=$(( LAST_END + 1 ))
  P3_END=$(( P3_START + EXTROOT_SECTORS - 1 ))
  P4_START=$(( P3_END + 1 ))

  partprobe "$DISK" 2>/dev/null
  parted -s "$DISK" unit s \
    "print" \
    "mkpart primary ext4 ${P3_START}s ${P3_END}s" \
    "mkpart primary ext4 ${P4_START}s 100%" || exit 0

  partprobe "$DISK"
  sleep 2

  P3="${DISK}p3"; [ -b "$P3" ] || P3="${DISK}3"
  P4="${DISK}p4"; [ -b "$P4" ] || P4="${DISK}4"
  [ -b "$P3" ] || exit 0
  [ -b "$P4" ] || exit 0

  mkfs.ext4 -F -L EXTROOT "$P3"
  mkfs.ext4 -F -L DOCKER  "$P4"

  # 配置 extroot (/overlay)
  uci -q delete fstab
  uci set fstab.@global[0].anon_mount='1'
  uci add fstab mount
  uci set fstab.@mount[-1].enabled='1'
  uci set fstab.@mount[-1].device='LABEL=EXTROOT'
  uci set fstab.@mount[-1].target='/overlay'
  uci set fstab.@mount[-1].fstype='ext4'
  uci set fstab.@mount[-1].options='rw,sync'
  uci set fstab.@mount[-1].is_rootfs='1'

  # 配置 Docker 分区 (/mnt/docker)
  uci add fstab mount
  uci set fstab.@mount[-1].enabled='1'
  uci set fstab.@mount[-1].device='LABEL=DOCKER'
  uci set fstab.@mount[-1].target='/mnt/docker'
  uci set fstab.@mount[-1].fstype='ext4'
  uci set fstab.@mount[-1].options='defaults'

  uci commit fstab
  /etc/init.d/fstab enable
  /etc/init.d/fstab restart

  # 写 Docker 默认目录
  mkdir -p /etc/docker
  cat > /etc/docker/daemon.json <<'EOF'
{
  "data-root": "/mnt/docker"
}
EOF

  touch "$FLAG"
  sync
  reboot
}
