#!/bin/sh /etc/rc.common
# 自动分区 + 格式化 + fstab + 挂载 + Docker data-root
# 适配 NanoPi R4S (mmcblk1: p1/p2 已存在，p3=EXTROOT ext4，p4=DOCKER ext4)
# 可通过环境变量覆盖：P3_SIZE_MIB(默认8192)、DEV(默认/dev/mmcblk1)

START=15
USE_PROCD=0

start() {
  exec >/root/autopart.log 2>&1
  set -euxo pipefail
  logger -t autopart "start"

  DEV="${DEV:-/dev/mmcblk1}"
  P3_SIZE_MIB="${P3_SIZE_MIB:-8192}"    # p3 分区大小，默认 8GiB；其余给 p4

  require_bin() { command -v "$1" >/dev/null 2>&1 || { logger -t autopart "missing $1"; exit 1; }; }
  for b in parted awk grep sed cut tr lsblk mkfs.ext4 block uci; do require_bin "$b"; done

  # 如果已是 extroot，或 /mnt/docker 已挂载，直接跳过（幂等）
  if mountpoint -q /overlay; then
    MNT_DEV="$(awk '$2=="/overlay"{print $1}' /proc/mounts || true)"
    logger -t autopart "overlay is ${MNT_DEV}, skip partitioning"
  fi
  if mountpoint -q /mnt/docker; then
    logger -t autopart "/mnt/docker already mounted, skip"
  fi

  # 读取当前分区表，拿到 p2 的结尾，作为 p3 起点
  # 仅当 p3/p4 不存在时才创建
  lsblk -lno NAME "${DEV}" || true
  HAVE_P3=0; HAVE_P4=0
  [ -b "${DEV}p3" ] && HAVE_P3=1
  [ -b "${DEV}p4" ] && HAVE_P4=1

  if [ "${HAVE_P3}" -eq 0 ] || [ "${HAVE_P4}" -eq 0 ]; then
    logger -t autopart "create p3/p4 on ${DEV}"

    # p2 结束位置 (MiB)
    P2_END_MIB="$(
      parted -s -m "${DEV}" unit MiB print | awk -F: '
        $1 ~ /^[0-9]+$/ && $1==2 { gsub("MiB","",$3); print int($3) }
      '
    )"
    [ -n "${P2_END_MIB}" ] || { logger -t autopart "failed to get p2 end"; exit 1; }

    P3_START_MIB=$((P2_END_MIB + 1))
    P3_END_MIB=$((P3_START_MIB + P3_SIZE_MIB))
    P4_START_MIB=$((P3_END_MIB + 1))

    # 创建分区（使用分区名以便 fstab 用 LABEL）
    parted -s "${DEV}" unit MiB \
      mkpart EXTROOT ext4 "${P3_START_MIB}" "${P3_END_MIB}" \
      mkpart DOCKER  ext4 "${P4_START_MIB}" 100%

    partprobe "${DEV}" || true
    sleep 2
  else
    logger -t autopart "p3/p4 already exist, skip creating"
  fi

  # 格式化（仅当不是 ext4 或无文件系统时）
  if ! blkid -t LABEL="EXTROOT" -o device >/dev/null 2>&1; then
    mkfs.ext4 -F -L EXTROOT "${DEV}p3"
  fi
  if ! blkid -t LABEL="DOCKER" -o device >/dev/null 2>&1; then
    mkfs.ext4 -F -L DOCKER  "${DEV}p4"
  fi

  # 写 fstab（使用 LABEL，避免设备名变动）
  mkdir -p /etc/config
  if ! uci -q show fstab >/dev/null 2>&1; then
    uci -q set fstab=@global[0]=global || uci -q add fstab global >/dev/null
  fi

  uci -q batch <<'EOF' || true
set fstab.@global[0]=global
set fstab.@global[0].anon_swap='0'
set fstab.@global[0].anon_mount='0'
set fstab.@global[0].auto_swap='1'
set fstab.@global[0].auto_mount='1'
set fstab.@global[0].delay_root='5'
set fstab.@global[0].check_fs='1'
EOF

  ensure_mount_cfg() {
    local target="$1" devspec="$2" fstype="$3" opts="$4"
    # 查是否已有相同 target
    if ! uci -q show fstab | grep -q "fstab.@mount\[[0-9]\+\].target='${target}'"; then
      uci -q add fstab mount >/dev/null
      idx=$(uci -q show fstab | sed -n '$s/.*@mount\[\([0-9]\+\)\].*/\1/p')
      uci -q set fstab.@mount["$idx"].target="${target}"
      uci -q set fstab.@mount["$idx"].device="${devspec}"
      uci -q set fstab.@mount["$idx"].fstype="${fstype}"
      uci -q set fstab.@mount["$idx"].enabled='1'
      [ -n "${opts}" ] && uci -q set fstab.@mount["$idx"].options="${opts}"
    fi
  }

  ensure_mount_cfg "/overlay"    "LABEL=EXTROOT" "ext4" "rw,noatime,data=ordered"
  mkdir -p /mnt/docker
  ensure_mount_cfg "/mnt/docker" "LABEL=DOCKER"  "ext4" "rw,noatime,data=ordered"

  uci -q commit fstab

  # 先尝试挂载（不强制重启）；extroot 通常需要下次重启才能生效
  block mount || true

  # 写 docker 配置（指向 /mnt/docker；如果没挂上，也无妨，下一次重启后就绪）
  mkdir -p /etc/docker
  cat >/etc/docker/daemon.json <<'JSON'
{
  "data-root": "/mnt/docker",
  "storage-driver": "overlay2",
  "log-driver": "json-file",
  "log-opts": { "max-size": "10m", "max-file": "3" },
  "iptables": true,
  "ip-masq": true,
  "exec-opts": ["native.cgroupdriver=systemd"]
}
JSON

  # 准备 cron（避免 AdGuardHome 启动脚本 grep 报错）
  mkdir -p /etc/crontabs
  : > /etc/crontabs/root

  logger -t autopart "done"
}
