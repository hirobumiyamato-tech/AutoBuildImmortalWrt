#!/bin/sh /etc/rc.common
# 首启：创建 p3=20G(ext4, EXTROOT -> /overlay)、p4=余量(ext4, DOCKER -> /mnt/docker)
# 幂等：若已存在 EXTROOT 标签或标记文件，则不重复执行
START=99
USE_PROCD=1
FLAG="/etc/.autopart_done"

find_boot_disk() {
  local src; src="$(findmnt -n -o SOURCE /rom 2>/dev/null)"
  [ -z "$src" ] && src="$(findmnt -n -o SOURCE / 2>/dev/null)"
  echo "$src"
}

base_disk_of() {
  local part="$1"
  case "$part" in
    *mmcblk*p[0-9]*) echo "${part%p[0-9]*}";;
    *nvme*n*p[0-9]*) echo "${part%p[0-9]*}";;
    *[0-9])          echo "${part%[0-9]}";;
    *)               echo "$part";;
  esac
}

start() {
  [ -f "$FLAG" ] && exit 0
  blkid | grep -q 'LABEL="EXTROOT"' && exit 0

  command -v parted >/dev/null 2>&1 || exit 0
  command -v mkfs.ext4 >/dev/null 2>&1 || exit 0

  BOOT_PART="$(find_boot_disk)"
  [ -z "$BOOT_PART" ] && exit 0
  DISK="$(base_disk_of "$BOOT_PART")"
  [ -b "$DISK" ] || exit 0

  EXTROOT_MB=20480  # 20GB

  P2="${DISK}p2"; [ -b "$P2" ] || P2="${DISK}2"
  [ -b "$P2" ] || exit 0

  END_SECTOR="$(cat /sys/class/block/$(basename "$P2")/size 2>/dev/null)"
  START_SECTOR_P2="$(cat /sys/class/block/$(basename "$P2")/start 2>/dev/null)"
  SECTOR_SIZE="$(cat /sys/class/block/$(basename "$DISK")/queue/hw_sector_size 2>/dev/null)"
  [ -z "$SECTOR_SIZE" ] && SECTOR_SIZE=512
  [ -z "$START_SECTOR_P2" ] && exit 0

  LAST_END=$(( START_SECTOR_P2 + END_SECTOR - 1 ))
  P3_SECTORS=$(( (EXTROOT_MB * 1024 * 1024 + SECTOR_SIZE - 1) / SECTOR_SIZE ))
  P3_START=$(( LAST_END + 1 ))
  P3_END=$(( P3_START + P3_SECTORS - 1 ))
  P4_START=$(( P3_END + 1 ))

  parted -s "$DISK" unit s \
    "mkpart primary ext4 ${P3_START}s ${P3_END}s" \
    "mkpart primary ext4 ${P4_START}s 100%" || exit 0

  partprobe "$DISK"
  sleep 2

  P3="${DISK}p3"; [ -b "$P3" ] || P3="${DISK}3"
  P4="${DISK}p4"; [ -b "$P4" ] || P4="${DISK}4"
  [ -b "$P3" ] || exit 0
  [ -b "$P4" ] || exit 0

  mkfs.ext4 -F -L EXTROOT "$P3"
  mkfs.ext4 -F -L DOCKER  "$P4"

  uci -q batch <<-EOF
    add fstab mount
    set fstab.@mount[-1].enabled='1'
    set fstab.@mount[-1].device='LABEL=EXTROOT'
    set fstab.@mount[-1].target='/overlay'
    set fstab.@mount[-1].fstype='ext4'
    set fstab.@mount[-1].options='rw,sync'
    set fstab.@mount[-1].is_rootfs='1'

    add fstab mount
    set fstab.@mount[-1].enabled='1'
    set fstab.@mount[-1].device='LABEL=DOCKER'
    set fstab.@mount[-1].target='/mnt/docker'
    set fstab.@mount[-1].fstype='ext4'
    set fstab.@mount[-1].options='defaults'
  EOF
  uci commit fstab
  /etc/init.d/fstab enable
  /etc/init.d/fstab restart

  mkdir -p /etc/docker
  cat > /etc/docker/daemon.json <<'JSON'
{
  "data-root": "/mnt/docker"
}
JSON

  touch "$FLAG"
  sync
  reboot
}
